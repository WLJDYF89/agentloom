# agentloom 环境变量样例
# 用法：复制为 .env 后按需修改。变量前缀统一为 AGENTLOOM_。

# ---- 基本信息 ----
AGENTLOOM_APP_NAME=agentloom
# local | test | staging | prod
AGENTLOOM_ENVIRONMENT=local
AGENTLOOM_DEBUG=false

# ---- HTTP ----
AGENTLOOM_HOST=0.0.0.0
AGENTLOOM_PORT=8000

# ---- 数据库（A05 起使用）----
AGENTLOOM_DATABASE_URL=postgresql+asyncpg://agentloom:agentloom@localhost:5432/agentloom
AGENTLOOM_DB_POOL_SIZE=10
AGENTLOOM_DB_POOL_TIMEOUT_S=5.0

# ---- 日志 ----
# DEBUG | INFO | WARNING | ERROR
AGENTLOOM_LOG_LEVEL=INFO

# ---- 以下由 A02 / A10 启用 ----
# POSTGRES_USER=agentloom
# POSTGRES_PASSWORD=agentloom
# POSTGRES_DB=agentloom
# DEEPSEEK_API_KEY=
